rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    function isNullableString(v, maxLen) {
      return v == null || isString(v, maxLen);
    }
    function isStringList(v) {
      return v is list && v.size() <= 100;
    }
    // A web source on an Echo reply: exactly { title <= 200, url <= 500 }.
    function isSource(v) {
      return v is map && v.keys().hasOnly(['title', 'url']) && v.keys().hasAll(['title', 'url'])
        && isString(v.title, 200) && isString(v.url, 500);
    }
    // At most 5 sources (rules have no loops, so each possible index is checked).
    function validSources(l) {
      return l is list && l.size() <= 5
        && (l.size() < 1 || isSource(l[0]))
        && (l.size() < 2 || isSource(l[1]))
        && (l.size() < 3 || isSource(l[2]))
        && (l.size() < 4 || isSource(l[3]))
        && (l.size() < 5 || isSource(l[4]));
    }
    function isNum(v, lo, hi) {
      return (v is int || v is float) && v >= lo && v <= hi;
    }
    function isNonNegNum(v) {
      return (v is int || v is float) && v >= 0;
    }
    // Writes always use serverTimestamp(), which arrives as request.time.
    function createStamps(d) {
      return d.createdAt == request.time && d.updatedAt == request.time;
    }
    function updateStamps(d) {
      return d.createdAt == resource.data.createdAt && d.updatedAt == request.time;
    }

    // ---------- legacy helpers ----------
    // An inheritor's access is evaluated with at most four get()s: link, settings, attempts, secret.
    // A missing doc makes get() fail, which denies; isOwner(uid) is always checked first.
    function linkPath(owner) {
      return /databases/$(database)/documents/legacyLinks/$(owner + '_' + request.auth.uid);
    }
    function settingsPath(owner) {
      return /databases/$(database)/documents/users/$(owner)/legacy/settings;
    }
    function attemptsPath(owner) {
      return /databases/$(database)/documents/legacyAttempts/$(owner + '_' + request.auth.uid);
    }
    // The signed-in user's link as inheritor of owner.
    function linkFor(owner) {
      return get(linkPath(owner));
    }
    // Owner has Legacy on and has been inactive longer than they chose. Computed live, so the
    // owner's next activity stamp locks it again.
    function released(owner) {
      let s = get(settingsPath(owner)).data;
      return s.enabled == true
        && request.time > s.lastActiveAt + duration.value(s.releaseAfterMinutes, 'm');
    }
    function unlocked(owner) {
      return request.auth != null
        && linkFor(owner).data.status == 'accepted'
        && released(owner)
        && get(attemptsPath(owner)).data.correct == true;
    }
    function shares(owner, kind) {
      return kind in linkFor(owner).data.shared;
    }

    match /users/{uid} {

      // ---------- profile ----------
      function validProfile(d) {
        return d.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'preferredName',
                'priorities', 'yearGoals', 'importantPeople', 'tone', 'checkInTime',
                'remindersEnabled', 'onboarded', 'caloriesEnabled', 'calorieGoal', 'checkInsEnabled',
                'checkInEveryMinutes', 'sleepStart', 'sleepEnd', 'waterGoal', 'language', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'preferredName',
                'priorities', 'yearGoals', 'importantPeople', 'tone', 'checkInTime',
                'remindersEnabled', 'onboarded', 'createdAt', 'updatedAt'])
          && d.uid == uid
          && isNullableString(d.email, 320)
          && isNullableString(d.displayName, 200)
          && isNullableString(d.photoURL, 2048)
          && isString(d.preferredName, 200)
          && isStringList(d.priorities)
          && isStringList(d.yearGoals)
          && isStringList(d.importantPeople)
          && isString(d.tone, 100)
          && isString(d.checkInTime, 5)
          && d.checkInTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && d.remindersEnabled is bool
          && d.onboarded is bool
          && (!('caloriesEnabled' in d) || d.caloriesEnabled is bool)
          && (!('calorieGoal' in d) || (d.calorieGoal is int && d.calorieGoal >= 800 && d.calorieGoal <= 6000))
          && (!('checkInsEnabled' in d) || d.checkInsEnabled is bool)
          && (!('checkInEveryMinutes' in d) || (d.checkInEveryMinutes is int && d.checkInEveryMinutes >= 1 && d.checkInEveryMinutes <= 43200))
          && (!('sleepStart' in d) || (isString(d.sleepStart, 5) && d.sleepStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
          && (!('sleepEnd' in d) || (isString(d.sleepEnd, 5) && d.sleepEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
          && (!('waterGoal' in d) || (d.waterGoal is int && d.waterGoal >= 1 && d.waterGoal <= 30))
          && (!('language' in d) || d.language in ['en', 'fil', 'taglish', 'ceb', 'ilo', 'hil', 'es', 'zh', 'hi',
                'ar', 'pt', 'fr', 'ja', 'ko', 'id', 'vi', 'de']);
      }

      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && createStamps(request.resource.data);
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && updateStamps(request.resource.data)
        && request.resource.data.uid == resource.data.uid;

      // ---------- notes ----------
      match /notes/{id} {
        function validNote(d) {
          return d.keys().hasOnly(['title', 'body', 'category', 'tags', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['title', 'body', 'category', 'tags', 'createdAt', 'updatedAt'])
            && isString(d.title, 500)
            && isString(d.body, 100000)
            && isString(d.category, 100)
            && isStringList(d.tags);
        }
        allow read: if isOwner(uid) || (unlocked(uid) && shares(uid, 'notes'));
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && validNote(request.resource.data)
          && createStamps(request.resource.data);
        allow update: if isOwner(uid) && validNote(request.resource.data)
          && updateStamps(request.resource.data);
      }

      // ---------- goals ----------
      // milestone element shape {text, done} is not checkable without loops in rules.
      match /goals/{id} {
        function validGoal(d) {
          return d.keys().hasOnly(['title', 'category', 'progress', 'streak', 'milestones', 'targetDate', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['title', 'category', 'progress', 'streak', 'milestones', 'createdAt', 'updatedAt'])
            && isString(d.title, 500)
            && isString(d.category, 100)
            && isNum(d.progress, 0, 100)
            && isNonNegNum(d.streak)
            && d.milestones is list && d.milestones.size() <= 100
            && (!('targetDate' in d) || (d.targetDate is string && d.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
        }
        allow read: if isOwner(uid) || (unlocked(uid) && shares(uid, 'goals'));
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && validGoal(request.resource.data)
          && createStamps(request.resource.data);
        allow update: if isOwner(uid) && validGoal(request.resource.data)
          && updateStamps(request.resource.data);
      }

      // ---------- healthLogs (doc id = YYYY-MM-DD; metrics optional) ----------
      match /healthLogs/{date} {
        function validHealth(d) {
          return d.keys().hasOnly(['date', 'mood', 'moodTag', 'sleepMinutes', 'waterGlasses', 'energy', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['date', 'createdAt', 'updatedAt'])
            && d.date == date
            && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && (!('mood' in d) || isNum(d.mood, 1, 10))
            && (!('moodTag' in d) || d.moodTag in ['great', 'happy', 'okay', 'tired', 'sad', 'anxious', 'angry'])
            && (!('sleepMinutes' in d) || isNonNegNum(d.sleepMinutes))
            && (!('waterGlasses' in d) || isNonNegNum(d.waterGlasses))
            && (!('energy' in d) || d.energy in ['low', 'medium', 'high']);
        }
        allow read: if isOwner(uid) || (unlocked(uid) && shares(uid, 'health'));
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && validHealth(request.resource.data)
          && createStamps(request.resource.data);
        allow update: if isOwner(uid) && validHealth(request.resource.data)
          && updateStamps(request.resource.data);
      }

      // ---------- meals (calorie tracker; item shapes {name,quantity,calories,protein?,carbs?,fat?} are validated client-side) ----------
      match /meals/{id} {
        function validMeal(d) {
          return d.keys().hasOnly(['date', 'mealType', 'description', 'items', 'totalCalories', 'source', 'estimated', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['date', 'mealType', 'description', 'items', 'totalCalories', 'source', 'estimated', 'createdAt', 'updatedAt'])
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
            && isString(d.description, 500)
            && d.items is list && d.items.size() <= 20
            && d.totalCalories is int && d.totalCalories >= 0 && d.totalCalories <= 20000
            && d.source in ['chat', 'call', 'manual']
            && d.estimated is bool;
        }
        allow read: if isOwner(uid) || (unlocked(uid) && shares(uid, 'health'));
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && validMeal(request.resource.data)
          && createStamps(request.resource.data);
        allow update: if isOwner(uid) && validMeal(request.resource.data)
          && updateStamps(request.resource.data);
      }

      // ---------- reminders (dueAt is a client Timestamp) ----------
      match /reminders/{id} {
        function validReminder(d) {
          return d.keys().hasOnly(['title', 'dueAt', 'done', 'source', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['title', 'dueAt', 'done', 'source', 'createdAt', 'updatedAt'])
            && isString(d.title, 500)
            && d.dueAt is timestamp
            && d.done is bool
            && d.source in ['chat', 'routine', 'manual'];
        }
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validReminder(request.resource.data)
          && createStamps(request.resource.data);
        allow update: if isOwner(uid) && validReminder(request.resource.data)
          && updateStamps(request.resource.data);
      }

      // ---------- routines ----------
      match /routines/{id} {
        function validRoutine(d) {
          return d.keys().hasOnly(['title', 'cadence', 'confidence', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['title', 'cadence', 'confidence', 'createdAt', 'updatedAt'])
            && isString(d.title, 500)
            && isString(d.cadence, 100)
            && isNum(d.confidence, 0, 1);
        }
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validRoutine(request.resource.data)
          && createStamps(request.resource.data);
        allow update: if isOwner(uid) && validRoutine(request.resource.data)
          && updateStamps(request.resource.data);
      }

      // ---------- messages (no updatedAt) ----------
      match /messages/{id} {
        function validMessage(d) {
          return d.keys().hasOnly(['role', 'text', 'category', 'createdAt'])
            && d.keys().hasAll(['role', 'text', 'createdAt'])
            && d.role in ['user', 'assistant']
            && isString(d.text, 20000)
            && (!('category' in d) || d.category in ['note', 'goal', 'health', 'reminder', 'connector', 'general']);
        }
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validMessage(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid) && validMessage(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // ---------- diaryPages (conversations) ----------
      // Stamps may be any timestamp <= request.time so the one-time migration can preserve original times;
      // serverTimestamp() (== request.time) satisfies this too. createdAt is immutable.
      match /diaryPages/{pageId} {
        function validMix(m) {
          return m is map && m.keys().hasOnly(['note', 'goal', 'reminder', 'health'])
            && (!('note' in m) || (m.note is int && m.note >= 0))
            && (!('goal' in m) || (m.goal is int && m.goal >= 0))
            && (!('reminder' in m) || (m.reminder is int && m.reminder >= 0))
            && (!('health' in m) || (m.health is int && m.health >= 0));
        }
        function validPage(d) {
          return d.keys().hasOnly(['title', 'preview', 'messageCount', 'createdAt', 'updatedAt', 'lastMessageAt', 'mix'])
            && d.keys().hasAll(['title', 'preview', 'messageCount', 'createdAt', 'updatedAt', 'lastMessageAt'])
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
            && isString(d.preview, 160)
            && d.messageCount is int && d.messageCount >= 0
            && d.updatedAt is timestamp && d.updatedAt <= request.time
            && d.lastMessageAt is timestamp && d.lastMessageAt <= request.time
            && (!('mix' in d) || validMix(d.mix));
        }
        allow read: if isOwner(uid) || (unlocked(uid) && shares(uid, 'diary'));
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && validPage(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid) && validPage(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        // create-only + delete; migration copies keep their original createdAt (<= request.time)
        match /messages/{id} {
          function validPageMessage(d) {
            return d.keys().hasOnly(['role', 'text', 'category', 'sources', 'checkIn', 'createdAt'])
              && d.keys().hasAll(['role', 'text', 'createdAt'])
              && d.role in ['user', 'assistant']
              && isString(d.text, 20000)
              && d.createdAt is timestamp && d.createdAt <= request.time
              && (!('category' in d) || d.category in ['note', 'goal', 'health', 'reminder', 'connector', 'general'])
              && (!('sources' in d) || validSources(d.sources))
              && (!('checkIn' in d) || d.checkIn is bool);
          }
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && validPageMessage(request.resource.data);
        }
      }

      // ---------- connectors (doc id = provider; batch set, no createdAt) ----------
      match /connectors/{provider} {
        function validConnector(d) {
          return d.keys().hasOnly(['name', 'connected', 'updatedAt', 'sealed', 'place', 'lat', 'lon', 'service', 'username'])
            && d.keys().hasAll(['name', 'connected', 'updatedAt'])
            && isString(d.name, 100)
            && d.connected is bool
            && (!('sealed' in d) || isString(d.sealed, 8192))
            && (!('place' in d) || isString(d.place, 100))
            && (!('lat' in d) || isNum(d.lat, -90, 90))
            && (!('lon' in d) || isNum(d.lon, -180, 180))
            && (!('service' in d) || d['service'] in ['lastfm', 'listenbrainz'])
            && (!('username' in d) || isString(d.username, 100))
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validConnector(request.resource.data);
      }

      // ---------- memories (no updatedAt; doc id = <type>-<slug>; type and createdAt immutable) ----------
      match /memories/{id} {
        function validMemory(d) {
          return d.keys().hasOnly(['label', 'type', 'links', 'mentions', 'createdAt', 'lastSeenAt', 'pages'])
            && d.keys().hasAll(['label', 'type', 'links', 'mentions', 'createdAt', 'lastSeenAt'])
            && isString(d.label, 500)
            && d.type in ['diary', 'task', 'goal', 'health', 'person', 'connector', 'interest', 'topic', 'trait']
            && d.links is list && d.links.size() <= 50
            && (!('pages' in d) || (d.pages is list && d.pages.size() <= 50))
            && d.mentions is int && d.mentions >= 1
            && d.lastSeenAt == request.time
            && id.matches(d.type + '-.+');
        }
        allow read: if isOwner(uid) || (unlocked(uid) && (
          (resource.data.type in ['person', 'interest', 'topic', 'trait', 'connector', 'task', 'diary'] && shares(uid, 'life'))
          || (resource.data.type in ['goal'] && shares(uid, 'goals'))
          || (resource.data.type in ['health'] && shares(uid, 'health'))));
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && validMemory(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid) && validMemory(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.type == resource.data.type;
      }

      // ---------- legacy (owner's settings and what an inheritor may see) ----------
      // Every settings write stamps lastActiveAt and updatedAt with serverTimestamp().
      match /legacy/settings {
        function validSettings(d) {
          return d.keys().hasOnly(['enabled', 'releaseAfterMinutes', 'lastActiveAt', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['enabled', 'releaseAfterMinutes', 'lastActiveAt', 'createdAt', 'updatedAt'])
            && d.enabled is bool
            && d.releaseAfterMinutes is int
            && d.releaseAfterMinutes >= 5
            && d.releaseAfterMinutes <= 1051200
            && d.lastActiveAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validSettings(request.resource.data)
          && createStamps(request.resource.data);
        allow update: if isOwner(uid) && validSettings(request.resource.data)
          && updateStamps(request.resource.data);
      }

      // Tells an accepted inheritor Locked from Released without spending a guess.
      match /legacy/beacon {
        function validBeacon(d) {
          return d.keys().hasOnly(['ownerName', 'updatedAt'])
            && d.keys().hasAll(['ownerName', 'updatedAt'])
            && isString(d.ownerName, 200)
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid) || (request.auth != null && linkFor(uid).data.status == 'accepted' && released(uid));
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBeacon(request.resource.data);
      }

      // A copy of the safe profile fields; users/{uid} itself stays owner-only.
      match /legacy/profile {
        function validLegacyProfile(d) {
          return d.keys().hasOnly(['displayName', 'preferredName', 'importantPeople', 'tone', 'language', 'updatedAt'])
            && d.keys().hasAll(['displayName', 'preferredName', 'importantPeople', 'tone', 'language', 'updatedAt'])
            && isNullableString(d.displayName, 200)
            && isString(d.preferredName, 200)
            && isStringList(d.importantPeople)
            && isString(d.tone, 100)
            && isNullableString(d.language, 20)
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid) || unlocked(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validLegacyProfile(request.resource.data);
      }

      // How the owner types. Read by every unlocked inheritor regardless of shared kinds.
      match /legacy/voice {
        function sampleOk(l, i) {
          return l.size() <= i || isString(l[i], 300);
        }
        function validSamples(l) {
          return l is list && l.size() <= 25
            && sampleOk(l, 0) && sampleOk(l, 1) && sampleOk(l, 2) && sampleOk(l, 3) && sampleOk(l, 4)
            && sampleOk(l, 5) && sampleOk(l, 6) && sampleOk(l, 7) && sampleOk(l, 8) && sampleOk(l, 9)
            && sampleOk(l, 10) && sampleOk(l, 11) && sampleOk(l, 12) && sampleOk(l, 13) && sampleOk(l, 14)
            && sampleOk(l, 15) && sampleOk(l, 16) && sampleOk(l, 17) && sampleOk(l, 18) && sampleOk(l, 19)
            && sampleOk(l, 20) && sampleOk(l, 21) && sampleOk(l, 22) && sampleOk(l, 23) && sampleOk(l, 24);
        }
        function nicknameOk(l, i) {
          return l.size() <= i || (l[i] is map
            && l[i].keys().hasOnly(['person', 'nickname']) && l[i].keys().hasAll(['person', 'nickname'])
            && isString(l[i].person, 200) && isString(l[i].nickname, 100));
        }
        function validNicknames(l) {
          return l is list && l.size() <= 20
            && nicknameOk(l, 0) && nicknameOk(l, 1) && nicknameOk(l, 2) && nicknameOk(l, 3) && nicknameOk(l, 4)
            && nicknameOk(l, 5) && nicknameOk(l, 6) && nicknameOk(l, 7) && nicknameOk(l, 8) && nicknameOk(l, 9)
            && nicknameOk(l, 10) && nicknameOk(l, 11) && nicknameOk(l, 12) && nicknameOk(l, 13) && nicknameOk(l, 14)
            && nicknameOk(l, 15) && nicknameOk(l, 16) && nicknameOk(l, 17) && nicknameOk(l, 18) && nicknameOk(l, 19);
        }
        function validVoice(d) {
          return d.keys().hasOnly(['summary', 'samples', 'nicknames', 'language', 'builtAt'])
            && d.keys().hasAll(['summary', 'samples', 'nicknames', 'language', 'builtAt'])
            && isString(d.summary, 4000)
            && validSamples(d.samples)
            && validNicknames(d.nicknames)
            && isNullableString(d.language, 20)
            && d.builtAt == request.time;
        }
        allow read: if isOwner(uid) || unlocked(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validVoice(request.resource.data);
      }

      // ---------- legacyChats (the inheritor's own memorial chat history; create-only) ----------
      match /legacyChats/{ownerUid}/messages/{id} {
        function validLegacyChat(d) {
          return d.keys().hasOnly(['role', 'text', 'createdAt'])
            && d.keys().hasAll(['role', 'text', 'createdAt'])
            && d.role in ['user', 'assistant']
            && isString(d.text, 4000)
            && d.createdAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validLegacyChat(request.resource.data);
      }
    }

    // ---------- userDirectory (find an inheritor by email; get only, never list) ----------
    match /userDirectory/{email} {
      function isOwnEmail() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == email;
      }
      function validDirectory(d) {
        return d.keys().hasOnly(['uid', 'displayName'])
          && d.keys().hasAll(['uid', 'displayName'])
          && d.uid == request.auth.uid
          && isNullableString(d.displayName, 200);
      }
      allow get: if request.auth != null;
      allow create, update: if isOwnEmail() && validDirectory(request.resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---------- legacyLinks (id = ownerUid_inheritorUid) ----------
    match /legacyLinks/{linkId} {
      function validLink(d) {
        return d.keys().hasOnly(['ownerUid', 'inheritorUid', 'ownerName', 'inheritorName', 'inheritorEmail',
                'status', 'questionId', 'shared', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['ownerUid', 'inheritorUid', 'ownerName', 'inheritorName', 'inheritorEmail',
                'status', 'questionId', 'shared', 'createdAt', 'updatedAt'])
          && isString(d.ownerUid, 128)
          && isString(d.inheritorUid, 128)
          && d.ownerUid != d.inheritorUid
          && linkId == d.ownerUid + '_' + d.inheritorUid
          && isNullableString(d.ownerName, 200)
          && isNullableString(d.inheritorName, 200)
          && isString(d.inheritorEmail, 320)
          && d.status in ['pending', 'accepted']
          && d.questionId is string && d.questionId.matches('^q[0-9]{1,3}$')
          && d.shared is list && d.shared.size() <= 5
          && d.shared.hasOnly(['life', 'goals', 'notes', 'diary', 'health']);
      }
      function isLinkOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
      function isLinkInheritor() {
        return request.auth != null && resource.data.inheritorUid == request.auth.uid;
      }
      // Clients query where('ownerUid', '==', me) or where('inheritorUid', '==', me).
      allow read: if isLinkOwner() || isLinkInheritor();
      allow delete: if isLinkOwner() || isLinkInheritor();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && validLink(request.resource.data)
        && request.resource.data.status == 'pending'
        && createStamps(request.resource.data);
      // Owner edits the question, shared kinds and names; inheritor only accepts.
      allow update: if validLink(request.resource.data) && (
        (isLinkOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['questionId', 'shared', 'ownerName', 'inheritorName', 'updatedAt'])
          && updateStamps(request.resource.data))
        || (isLinkInheritor()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.updatedAt == request.time));
    }

    // ---------- legacy link-id ownership (uids never contain '_') ----------
    function ownsLinkId(linkId) {
      return request.auth != null && linkId.matches(request.auth.uid + '_.+');
    }
    function inheritsLinkId(linkId) {
      return request.auth != null && linkId.matches('.+_' + request.auth.uid);
    }

    // ---------- legacySecrets (answer hash; nobody reads it, rules get() it) ----------
    match /legacySecrets/{linkId} {
      function validSecret(d) {
        return d.keys().hasOnly(['answerHash']) && d.keys().hasAll(['answerHash'])
          && d.answerHash is string && d.answerHash.matches('^[0-9a-f]{64}$');
      }
      allow read: if false;
      allow create, update: if ownsLinkId(linkId) && validSecret(request.resource.data);
      allow delete: if ownsLinkId(linkId);
    }

    // ---------- legacyAttempts (guesses; the inheritor writes while the owner is released) ----------
    // A window lasts 24 hours from its first guess; after that the count starts over at 1.
    match /legacyAttempts/{linkId} {
      function windowExpired() {
        return resource == null || request.time > resource.data.windowStart + duration.value(86400, 's');
      }
      function validAttempt(d) {
        return d.keys().hasOnly(['count', 'windowStart', 'guessHash', 'correct', 'lastAt'])
          && d.keys().hasAll(['count', 'windowStart', 'guessHash', 'correct', 'lastAt'])
          && d.guessHash is string && d.guessHash.size() == 64
          && d.correct == (d.guessHash == get(/databases/$(database)/documents/legacySecrets/$(linkId)).data.answerHash)
          && d.lastAt == request.time
          && ((windowExpired() && d.count == 1 && d.windowStart == request.time)
            || (!windowExpired()
              && d.count == resource.data.count + 1
              && d.count <= 5
              && d.windowStart == resource.data.windowStart));
      }
      function canGuess() {
        let link = get(/databases/$(database)/documents/legacyLinks/$(linkId)).data;
        return request.auth != null
          && link.inheritorUid == request.auth.uid
          && link.status == 'accepted'
          && released(link.ownerUid);
      }
      allow read: if ownsLinkId(linkId) || inheritsLinkId(linkId);
      allow delete: if ownsLinkId(linkId);
      allow create, update: if canGuess() && validAttempt(request.resource.data);
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
