<mxfile host="app.diagrams.net"><diagram name="Echo Architecture" id="echo-arch"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style='font-size:20px'&gt;Echo — Architecture&lt;/b&gt;&lt;br&gt;“A diary that speaks back” · Next.js 16 on Vercel · Firebase · Google Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=13;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1460" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;① Browser / PWA  (React 19 · TypeScript · Tailwind 4)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=14;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="400" height="760" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;② Vercel — Next.js API routes (Node, stateless)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#d79b00;fontSize=14;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="460" height="760" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;③ Firebase (Google)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7ea;strokeColor=#82b366;fontSize=14;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="520" height="330" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;④ External APIs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eefa;strokeColor=#9673a6;fontSize=14;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="440" width="520" height="410" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Screens&lt;/b&gt;&lt;br&gt;Home/Diary chat · Notes · Goals · Health · Reminders&lt;br&gt;Period filters: Today / Week / Month / All" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="360" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Voice call panel&lt;/b&gt;&lt;br&gt;16 kHz PCM mic ⇄ Gemini Live (WebSocket)&lt;br&gt;runs tool calls in the browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="360" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;2nd Brain view&lt;/b&gt;&lt;br&gt;memory graph (d3-force)&lt;br&gt;people · interests · topics · traits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="360" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;applyActions()&lt;/b&gt;  (lib/echo/client.ts)&lt;br&gt;writes notes/goals/reminders/meals/health&lt;br&gt;upserts memories (1 transaction) · Undo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="360" height="75" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Context builder&lt;/b&gt;&lt;br&gt;profile · last 10 msgs · top 40 memories (10 trait slots)&lt;br&gt;item refs (r1, g2…) · connectors · WEATHER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="360" height="75" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Connectors view&lt;/b&gt;&lt;br&gt;Web search (Tavily login) · Nutrition · Weather" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf