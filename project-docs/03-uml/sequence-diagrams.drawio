<mxfile host="app.diagrams.net" agent="Echo Legacy engine docs"><diagram name="1. Ask a question" id="sq1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1390" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sq1-2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Sequence 1 — A registered asker asks a question&lt;/b&gt;&lt;br&gt;Maria asks &quot;What did he write about family?&quot; after the death trigger. Only permitted entries ever reach the model.&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Team: Peter Paul Poloan — Front End, Back End, Q/A, UI/UX Designer, Documentator (one-member group)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1310" height="70" as="geometry"/></mxCell><mxCell id="sq1-3" value="Maria : Registered Asker" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;verticalAlign=top;spacingTop=36;outlineConnect=0;size=40;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="120" height="900" as="geometry"/></mxCell><mxCell id="sq1-4" value="Echo UI&lt;br&gt;(Ask screen)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="120" height="900" as="geometry"/></mxCell><mxCell id="sq1-5" value="Q&amp;amp;A script&lt;br&gt;(scripting)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="120" height="900" as="geometry"/></mxCell><mxCell id="sq1-6" value="Tools&lt;br&gt;search / check / fetch" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="120" height="900" as="geometry"/></mxCell><mxCell id="sq1-7" value="Prolog&lt;br&gt;access rules" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="120" height="900" as="geometry"/></mxCell><mxCell id="sq1-8" value="vault : Vault" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="120" height="900" as="geometry"/></mxCell><mxCell id="sq1-9" value="Gemini model&lt;br&gt;(external)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="120" height="900" as="geometry"/></mxCell><mxCell id="sq1-10" value="1. ask(&quot;What did he write about family?&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="170" as="sourcePoint"/><mxPoint x="290" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-11" value="2. answer(asker from session, question)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="204" as="sourcePoint"/><mxPoint x="460" y="204" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-12" value="3. verify()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="238" as="sourcePoint"/><mxPoint x="970" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-13" value="4. true (else TamperDetected)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="272" as="sourcePoint"/><mxPoint x="460" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-14" value="5. question + instructions + tool list" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="306" as="sourcePoint"/><mxPoint x="1140" y="306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-15" value="6. call search_entries(&quot;family&quot;)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="340" as="sourcePoint"/><mxPoint x="460" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-16" value="7. search_entries(maria, &quot;family&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="374" as="sourcePoint"/><mxPoint x="630" y="374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-17" value="8. can_see(maria, summary, E)?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="408" as="sourcePoint"/><mxPoint x="800" y="408" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-18" value="9. E = e1, e3, e5, … (deny by default, deny beats allow)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="442" as="sourcePoint"/><mxPoint x="630" y="442" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-19" value="10. entriesFor(maria, summary, today)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="476" as="sourcePoint"/><mxPoint x="970" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-20" value="11. frozen copies of permitted entries" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="510" as="sourcePoint"/><mxPoint x="630" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-21" value="12. { count, matches: [entry_id, date, summary] }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="544" as="sourcePoint"/><mxPoint x="460" y="544" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-22" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=24;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="220" y="568" width="990" height="232" as="geometry"/></mxCell><mxCell id="sq1-23" value="[permitted entries found]" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="276" y="568" width="300" height="22" as="geometry"/></mxCell><mxCell id="sq1-24" value="13. tool results only" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="600" as="sourcePoint"/><mxPoint x="1140" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-25" value="14. { answer, citations: [2019-03-02, …] }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="634" as="sourcePoint"/><mxPoint x="460" y="634" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-26" value="15. every claim cited? quotes only from full access?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;curved=0;align=left;spacingLeft=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="668" as="sourcePoint"/><mxPoint x="460" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-27" value="16. cited answer" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="708" as="sourcePoint"/><mxPoint x="290" y="708" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-28" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="742" as="sourcePoint"/><mxPoint x="1210" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-29" value="[nothing permitted, or any error]" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="226" y="742" width="340" height="22" as="geometry"/></mxCell><mxCell id="sq1-30" value="17. neutral reply: &quot;I don't have anything I can share about that.&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="772" as="sourcePoint"/><mxPoint x="290" y="772" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-31" value="18. show answer with dates" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="816" as="sourcePoint"/><mxPoint x="120" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq1-32" value="The model never reads the vault directly: it sees only what the tools return, and the tools ask the Prolog rules first." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="844" width="420" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Write an entry" id="sq2"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1390" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sq2-2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Sequence 2 — The owner writes an entry&lt;/b&gt;&lt;br&gt;The writing mode is chosen by polymorphism; the pipeline is pure; the entry is appended to the hash chain. The original text is always kept.&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Team: Peter Paul Poloan — Front End, Back End, Q/A, UI/UX Designer, Documentator (one-member group)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1310" height="70" as="geometry"/></mxCell><mxCell id="sq2-3" value="Ramon : Owner" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;verticalAlign=top;spacingTop=36;outlineConnect=0;size=40;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="120" height="700" as="geometry"/></mxCell><mxCell id="sq2-4" value="Echo UI&lt;br&gt;(Write screen)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="120" height="700" as="geometry"/></mxCell><mxCell id="sq2-5" value="mode : WritingMode&lt;br&gt;(LightFix)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="120" height="700" as="geometry"/></mxCell><mxCell id="sq2-6" value="Pipeline&lt;br&gt;(pure functions)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="120" height="700" as="geometry"/></mxCell><mxCell id="sq2-7" value="entry : DiaryEntry" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="120" height="700" as="geometry"/></mxCell><mxCell id="sq2-8" value="vault : Vault" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="120" height="700" as="geometry"/></mxCell><mxCell id="sq2-9" value="HashChain" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="120" height="700" as="geometry"/></mxCell><mxCell id="sq2-10" value="1. type text, tags; choose mode light_fix" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="170" as="sourcePoint"/><mxPoint x="290" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-11" value="2. WritingMode.forName(&quot;light_fix&quot;).apply(text)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="204" as="sourcePoint"/><mxPoint x="460" y="204" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-12" value="3. processEntryText(text, tags, knownPeople)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="238" as="sourcePoint"/><mxPoint x="630" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-13" value="4. { original, normalized, corrected, extracted, changes }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="272" as="sourcePoint"/><mxPoint x="460" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-14" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=24;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="296" width="650" height="196" as="geometry"/></mxCell><mxCell id="sq2-15" value="[mode = review]" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="106" y="296" width="300" height="22" as="geometry"/></mxCell><mxCell id="sq2-16" value="5. corrected text + diff [-teh-] {+the+}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="328" as="sourcePoint"/><mxPoint x="290" y="328" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-17" value="6. accept or reject the correction" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="362" as="sourcePoint"/><mxPoint x="290" y="362" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-18" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="396" as="sourcePoint"/><mxPoint x="700" y="396" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-19" value="[mode = verbatim or light_fix]" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="56" y="396" width="340" height="22" as="geometry"/></mxCell><mxCell id="sq2-20" value="7. final text (original kept alongside)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="426" as="sourcePoint"/><mxPoint x="290" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-21" value="8. new DiaryEntry({ id, date, text, tags })" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="476" as="sourcePoint"/><mxPoint x="800" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-22" value="9. append(entry)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="510" as="sourcePoint"/><mxPoint x="970" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-23" value="10. appendLink(chain, entry)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="544" as="sourcePoint"/><mxPoint x="1140" y="544" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-24" value="11. new frozen chain (prevHash → hash)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="578" as="sourcePoint"/><mxPoint x="970" y="578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-25" value="12. count()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="612" as="sourcePoint"/><mxPoint x="290" y="612" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sq2-26" value="13. &quot;Saved · chain verified&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="646" as="sourcePoint"/><mxPoint x="120" y="646" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="3. Compile a policy" id="sq3"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1390" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sq3-2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Sequence 3 — The owner saves a legacy policy&lt;/b&gt;&lt;br&gt;Lexer → recursive-descent parser → interpreter → Prolog facts. After the death trigger the policy is frozen.&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Team: Peter Paul Poloan — Front End, Back End, Q/A, UI/UX Designer, Documentator (one-member group)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1310" height="70" as="geometry"/></mxCell><mxCell id="sq3-3" value="Ramon : Owner" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;verticalAlign=top;spacingTop=36;outlineConnect=0;size=40;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="120" height="760" as="geometry"/></mxCell><mxCell id="sq3-4" value="Policy editor" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="120" height="760" as="geometry"/></mxCell><mxCell id="sq3-5" value="ramon : Owner&lt;br&gt;(model)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="120" height="760" as="geometry"/></mxCell><mxCell id="sq3-6" value="Lexer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="120" height="760" as="geometry"/></mxCell><mxCell id="sq3-7" value="Parser&lt;br&gt;(recursive descent)" style="shape=umlLifeline;peri