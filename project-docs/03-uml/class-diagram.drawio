<mxfile host="app.diagrams.net" agent="Echo Legacy engine docs"><diagram name="Class Diagram" id="cls"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cls-2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Echo Legacy engine — Class Diagram&lt;/b&gt;&lt;br&gt;Built classes match engine/src exactly. «planned» classes come with later tickets. Visibility: + public, - private (#field), {static}, «abstract».&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Team: Peter Paul Poloan — Front End, Back End, Q/A, UI/UX Designer, Documentator (one-member group)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="70" as="geometry"/></mxCell><mxCell id="cls-3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Entry&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- #data: EntryData&lt;hr size=&quot;1&quot;&gt;+ id, date, text, tags {get}&lt;br&gt;+ kind: string «abstract»&lt;br&gt;+ describe(): string «abstract»&lt;br&gt;+ summarize(maxWords = 20): string&lt;br&gt;+ isReadableOn(today, asker): boolean&lt;br&gt;+ toRecord(): EntryRecord" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="290" height="172" as="geometry"/></mxCell><mxCell id="cls-4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;DiaryEntry&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&amp;nbsp;&lt;hr size=&quot;1&quot;&gt;+ kind = &amp;quot;diary&amp;quot;&lt;br&gt;+ describe(): string" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;