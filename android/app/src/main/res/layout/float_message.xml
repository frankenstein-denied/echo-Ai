<?xml version="1.0" encoding="utf-8"?>
<!-- The small check-in message beside the bubble. The outer padding leaves the window room for the card's shadow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/float_message_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_float_message"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/float_message_name"
            android:textColor="#0F9C8A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/float_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:textColor="#14181D"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
