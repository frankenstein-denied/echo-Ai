<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded pinned notification. RemoteViews: only LinearLayout/TextView/ProgressBar used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/signed_out"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/notif_signed_out"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_reminders"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/notif_tab_reminders" />

            <TextView
                android:id="@+id/tab_goals"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/notif_tab_goals" />

            <TextView
                android:id="@+id/tab_notes"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/notif_tab_notes" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Up to 3 nested notif_pinned_row RemoteViews are added here at runtime. -->
        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_talk"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/notif_button_bg"
                android:gravity="center"
                android:text="@string/notif_talk" />

            <TextView
                android:id="@+id/btn_type"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/notif_button_bg"
                android:gravity="center"
                android:text="@string/notif_type" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
